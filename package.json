{
  "name": "phoget",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env scripts/dev.ts",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "NODE_ENV=production vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file=.env dist/server/index.js",
    "db:seed": "tsx --env-file=.env server/db/seed.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint src server shared scripts tests .storybook *.ts && stylelint \"src/**/*.css\" \".storybook/*.css\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "tsx --env-file=.env.test --test tests/api.test.ts tests/colors.test.ts tests/activity.test.ts tests/icons.test.ts tests/dev.test.ts tests/branding.test.ts",
    "test:branding": "tsx --test tests/branding.test.ts",
    "test:e2e": "npm run build && tsx --env-file=.env.test tests/prepareAccounts.ts && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:e2e && npm run test:storybook",
    "db:setup": "node --env-file=.env node_modules/drizzle-kit/bin.cjs push && tsx --env-file=.env server/db/setup.ts",
    "db:setup:test": "node --env-file=.env.test node_modules/drizzle-kit/bin.cjs push && tsx --env-file=.env.test server/db/setup.ts",
    "account:setup": "tsx --env-file=.env server/auth/setupAdmin.ts",
    "account:setup:production": "node --env-file=.env dist/server/auth/setupAdmin.js",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "test:storybook": "npm run build:storybook && playwright test --config playwright.storybook.config.ts",
    "gallery:errors": "npm run build && tsx --env-file=.env.test tests/prepareAccounts.ts && playwright test --config playwright.error-gallery.config.ts",
    "gallery:errors:serve": "vite error-gallery --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@types/express": "5.0.6",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "storybook": "10.5.10",
    "storybook-addon-pseudo-states": "10.5.10",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0"
}
