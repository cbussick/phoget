{
  "$schema": "https://unpkg.com/knip@6.42.1/schema-jsonc.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "src/app/main.tsx!",
    "server/index.ts!",
    "server/auth/setupAdmin.ts!",
    "server/db/setup.ts!",
    "server/db/seed.ts",
    "server/db/seedDevelopment.ts",
    "scripts/worktree.mjs",
    "tests/*.test.ts",
    "tests/*.spec.ts",
    "scripts/errorGallery.spec.ts",
    "playwright*.config.ts",
    "drizzle.config.ts",
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "server/**/*.ts!",
    "shared/**/*.ts!",
    "!src/**/*.stories.tsx!",
    "!server/db/seed.ts!",
    "!server/db/seedDevelopment.ts!",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.ts",
    ".storybook/**/*.{ts,tsx}",
    "*.{ts,js}",
  ],
  // These configs require a provisioned database/runtime even to import.
  // Analyze them statically, with their test/schema roots listed above instead.
  "playwright": false,
  "drizzle": false,
}
